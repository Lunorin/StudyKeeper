# ============================================================================
# StudyKeeper 本地 Docker Compose 环境变量 —— 示例文件（**这个进 Git，真值不要写在这里**）
#
# 用法：复制成同目录的 .env 再填真值
#   Windows  PowerShell :  Copy-Item .env.example .env
#   macOS / Linux       :  cp .env.example .env
# docker compose 会自动读同目录的 .env。
# ============================================================================

# ---------- MySQL 容器 ----------
# root 密码：给个强密码就行（这库只在 Docker 内网用，不映射到宿主机端口）
MYSQL_ROOT_PASSWORD=change-me-strong-password
# 库名：mysql 会建这个库，backend 连的也是它，改这里两边会一起跟着变
MYSQL_DATABASE=study_agent

# ---------- Java 后端 ----------
# JWT 签名密钥：**至少 32 字节**（HS256 要求），少于 32 字节应用启动直接失败。
# 生成一个：openssl rand -hex 32（或者随便敲 40 多个字符）
# 注意：改它会让已签发的 token 全部失效（本地无所谓，重新登录即可）
JWT_SECRET=change-me-please-at-least-32-bytes-long-secret

# ---------- AI 服务（StudyKeeper-ai）----------
# 缺这个值服务照样能起（config.py 只打警告），但 /ai/* 调大模型时会失败
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 邮件（注册 / 找回密码的发验证码）----------
# QQ 邮箱的「授权码」，不是登录密码；留空的话服务照常启动，
# 只是发验证码接口会返回 400（见 StudyKeeper/docs/decisions.md §13）
MAIL_USERNAME=your-qq@qq.com
MAIL_PASSWORD=
